PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lawyer_leads
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins (landing page + admin panel)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# First admin account, created automatically on startup if no admin exists
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
